@model List<Sunset.Modelos.Dtos.AgendaQuadraDto>
@{
    ViewData["Title"] = "Agenda do gestor";
}

<h1 class="h3 mb-3">Agenda dos próximos 5 dias</h1>

@if (TempData["Mensagem"] is string mensagem)
{
    <div class="alert alert-success">@mensagem</div>
}
@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-danger">@erro</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">Você ainda não tem quadras cadastradas.</p>
}

@foreach (var q in Model)
{
    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-bold">@q.Quadra.NomeQuadra <span class="text-muted fw-normal">(@q.Quadra.Categoria)</span></div>
        <div class="card-body">
            @foreach (var dia in q.Dias)
            {
                <h2 class="h6 mt-2">@dia.Data.ToString("dddd, dd/MM")</h2>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <tbody>
                            @foreach (var h in dia.Horarios)
                            {
                                <tr>
                                    <td style="width: 8rem">@h.Inicio - @h.Fim</td>
                                    @if (h.Ocupado)
                                    {
                                        <td><span class="badge text-bg-secondary">Agendado</span> @h.Cliente</td>
                                        <td class="text-end">
                                            @if (!h.Passado)
                                            {
                                                <form asp-action="Cancelar" method="post" class="d-inline"
                                                      onsubmit="return confirm('Cancelar este agendamento?');">
                                                    <input type="hidden" name="id" value="@h.AgendamentoId" />
                                                    <input type="hidden" name="voltar" value="agenda" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                                                </form>
                                            }
                                        </td>
                                    }
                                    else
                                    {
                                        <td colspan="2"><span class="badge text-bg-success">Livre</span></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
