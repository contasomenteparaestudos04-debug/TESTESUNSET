@model Sunset.Modelos.Dtos.QuadraSalvarDto
@* Partial view: os campos da quadra, usados em Criar e em Editar. *@

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-12 col-md-6">
        <label asp-for="NomeQuadra" class="form-label"></label>
        <input asp-for="NomeQuadra" class="form-control" />
        <span asp-validation-for="NomeQuadra" class="text-danger"></span>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="Categoria" class="form-label"></label>
        <select asp-for="Categoria" class="form-select">
            <option value="Volei">Vôlei</option>
            <option value="Beach Tennis">Beach Tennis</option>
        </select>
        <span asp-validation-for="Categoria" class="text-danger"></span>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="PrecoHora" class="form-label"></label>
        <input asp-for="PrecoHora" class="form-control" />
        <span asp-validation-for="PrecoHora" class="text-danger"></span>
    </div>
</div>

<h2 class="h6 mt-4">Endereço</h2>
<div class="row g-3 mb-3">
    <div class="col-12 col-md-3">
        <label asp-for="Cep" class="form-label"></label>
        <input asp-for="Cep" class="form-control" placeholder="00000-000" />
        <span asp-validation-for="Cep" class="text-danger"></span>
    </div>
    <div class="col-8 col-md-6">
        <label asp-for="Logradouro" class="form-label"></label>
        <input asp-for="Logradouro" class="form-control" />
        <span asp-validation-for="Logradouro" class="text-danger"></span>
    </div>
    <div class="col-4 col-md-3">
        <label asp-for="Numero" class="form-label"></label>
        <input asp-for="Numero" class="form-control" placeholder="S/N" />
        <span asp-validation-for="Numero" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-4">
        <label asp-for="Bairro" class="form-label"></label>
        <input asp-for="Bairro" class="form-control" />
        <span asp-validation-for="Bairro" class="text-danger"></span>
    </div>
    <div class="col-8 col-md-5">
        <label asp-for="Cidade" class="form-label"></label>
        <input asp-for="Cidade" class="form-control" />
        <span asp-validation-for="Cidade" class="text-danger"></span>
    </div>
    <div class="col-4 col-md-3">
        <label asp-for="Estado" class="form-label"></label>
        <input asp-for="Estado" class="form-control" placeholder="SP" />
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>
</div>
