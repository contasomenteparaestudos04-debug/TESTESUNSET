@{
    ViewData["Title"] = "Painel do administrador";
}

<h1 class="h3 mb-3">Painel do administrador</h1>

<div class="row g-3">
    <div class="col-12 col-md-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h2 class="h5">Usuários</h2>
            <p class="text-muted">Buscar por nome ou e-mail e excluir contas.</p>
            <a asp-action="Usuarios" class="btn btn-primary">Abrir</a>
        </div></div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h2 class="h5">Agendamentos</h2>
            <p class="text-muted">Filtrar por nome e período e excluir agendamentos.</p>
            <a asp-action="Agendamentos" class="btn btn-primary">Abrir</a>
        </div></div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h2 class="h5">Quadras</h2>
            <p class="text-muted">O Admin vê e gerencia todas as quadras.</p>
            <a asp-controller="Quadras" asp-action="Index" class="btn btn-primary">Abrir</a>
        </div></div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100 shadow-sm"><div class="card-body">
            <h2 class="h5">Relatório</h2>
            <p class="text-muted">Baixa um resumo geral do sistema em arquivo TXT.</p>
            <a asp-action="Relatorio" class="btn btn-outline-primary">Baixar TXT</a>
        </div></div>
    </div>
</div>
