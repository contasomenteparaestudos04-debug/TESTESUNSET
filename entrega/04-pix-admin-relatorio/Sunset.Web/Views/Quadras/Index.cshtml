@model List<Sunset.Modelos.Dtos.QuadraDto>
@{
    ViewData["Title"] = "Minhas quadras";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 m-0">Minhas quadras</h1>
    <a asp-action="Criar" class="btn btn-primary">Nova quadra</a>
</div>

@if (TempData["Mensagem"] is string mensagem)
{
    <div class="alert alert-success">@mensagem</div>
}
@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-danger">@erro</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">Você ainda não cadastrou nenhuma quadra. Cadastre a sua para receber agendamentos e virar gestor.</p>
}
else
{
    @* table-responsive: no celular a tabela rola de lado em vez de estourar a tela *@
    <div class="table-responsive">
        <table class="table table-striped align-middle tabela-celular">
            <thead>
                <tr>
                    <th>Quadra</th>
                    <th>Esporte</th>
                    <th>Preço/hora</th>
                    <th>Endereço</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var q in Model)
                {
                    <tr>
                        <td data-label="Quadra">@q.NomeQuadra</td>
                        <td data-label="Esporte">@q.Categoria</td>
                        <td data-label="Preço/hora">@q.PrecoHora.ToString("C2")</td>
                        <td data-label="Endereço">@q.Endereco</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Editar" asp-route-id="@q.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Excluir" asp-route-id="@q.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
