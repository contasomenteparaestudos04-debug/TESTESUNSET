@model Sunset.Modelos.Dtos.CadastroDto
@{
    ViewData["Title"] = "Criar conta";
}

<div class="cartao-centro">
    <h1 class="h3 mb-1">Criar conta</h1>
    <p class="text-muted">Cadastre-se para agendar!</p>

    <form asp-action="Cadastro" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-3">
            <div class="col-12 col-sm-6">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="col-12 col-sm-6">
                <label asp-for="Sobrenome" class="form-label"></label>
                <input asp-for="Sobrenome" class="form-control" />
                <span asp-validation-for="Sobrenome" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Cpf" class="form-label"></label>
                <input asp-for="Cpf" class="form-control" placeholder="000.000.000-00" />
                <span asp-validation-for="Cpf" class="text-danger"></span>
            </div>
            <div class="col-12 col-sm-6">
                <label asp-for="Senha" class="form-label"></label>
                <input asp-for="Senha" class="form-control" autocomplete="new-password" />
                <div class="form-text">Mínimo de 8 caracteres.</div>
                <span asp-validation-for="Senha" class="text-danger"></span>
            </div>
            <div class="col-12 col-sm-6">
                <label asp-for="ConfirmarSenha" class="form-label"></label>
                <input asp-for="ConfirmarSenha" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="QuerSerGestor" class="form-check-input" />
                    <label asp-for="QuerSerGestor" class="form-check-label"></label>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-3">Cadastrar</button>
    </form>

    <p class="mt-3 mb-0 text-center"><a asp-action="Login">Voltar ao login</a></p>
</div>
